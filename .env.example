# Copy this file to .env and fill it in. Keep comments on their own lines.

# dry  = paper trading: nothing is sent to the broker, but every signal opens a virtual
#        position that is filled from the live candles and recorded in journal.db (start here)
# demo = sends orders, but only when the logged-in MT5 account is a demo account
# live = sends orders on any account, real money included. Flip this by hand, on purpose.
MODE=dry

# rules  = strategies.py decides (free, same answer every time)
# ai     = Claude decides buy / sell / hold each closed candle (ai_strategy.py) and learns
#          from its own trades through journal.db. Costs money per candle: on M15 that is
#          up to 96 API calls a day, plus one short call after every closed trade.
# hybrid = strategies.py proposes setups, Claude takes one or holds. Only candles with a
#          setup cost an API call, and Claude cannot trade a direction no setup proposed.
BRAIN=rules
# Setups for rules and hybrid: ma_cross, trend_pullback, bollinger_breakout, rsi_reversion,
# mr_zscore (pair it with SL_ATR=1.0 TP_ATR=2.0), a comma-separated list, or all.
# Compare them on your own data first:
#   python replay.py history.csv --compare
STRATEGY=trend_pullback
# Which AI answers for BRAIN=ai and hybrid: claude, openai (GPT) or gemini. Each needs its own
# key below, billed by that company. Never commit this file.
AI_PROVIDER=claude
# Leave empty for the default (claude-sonnet-5-5, gpt-6.1-sol, gemini-3.8-flash). Another
# model works, but the spend estimate keeps the default model's prices.
AI_MODEL=
# https://platform.claude.com (billed separately from a Claude subscription)
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# USD the AI may spend per day in bot.py (per run in replay.py). Once reached the bot holds
# until the next day. Estimated from token usage at Claude Sonnet 5.5 list prices.
AI_BUDGET_USD=5

# Symbol name exactly as your broker shows it (XAUUSD, XAUUSDm, GOLD, EURUSD, ...)
SYMBOL=XAUUSD
# M1 M5 M15 M30 H1 H4 D1
TIMEFRAME=M15
LOT=0.01
# Units per 1.0 lot, used to price paper and replay trades: 100 for gold, 100000 for most
# forex pairs. export_history.py prints what your broker uses.
CONTRACT_SIZE=100

# Stop loss and take profit as multiples of ATR(ATR_PERIOD), so they widen when the market
# moves more and tighten when it is quiet. The stop never sits closer than two spreads or
# the broker's minimum. Set SL_ATR or TP_ATR to 0 to use the fixed points below instead.
SL_ATR=1.5
TP_ATR=3.0
ATR_PERIOD=14
# Fixed distances in points, used when SL_ATR / TP_ATR are 0 (or no ATR is known yet).
# Point size differs per broker: on gold quoted with 2 decimals 500 points = 5.00, with
# 3 decimals it is only 0.50. Check yours.
SL_POINTS=500
TP_POINTS=1000
MAX_SPREAD_POINTS=50

# Stop opening trades once today's realized loss reaches this (account currency).
# In dry mode paper losses count too.
MAX_DAILY_LOSS=20
# Stop opening trades after this many today (this bot's own, paper or MT5). 0 = no limit.
MAX_TRADES_PER_DAY=0

# Tags this bot's orders so it only counts its own positions
MAGIC=20261003
# IOC, FOK or RETURN. Change it if orders fail with "Unsupported filling mode"
FILLING=IOC

# From @BotFather. Leave empty to run with console output only.
# Commands: /status /pause /resume /stop /playbook /lessons
TELEGRAM_TOKEN=
# Your chat id. Message the bot once: the console prints "ignored message from chat <id>"
TELEGRAM_CHAT_ID=

# Outside signals, on top of the strategies. Every one still passes the risk rules above.
# on: TradingView alerts posted to https://ntfy.sh/<WEBHOOK_TOPIC> with a message saying
# buy or sell. The topic is the only secret: the dashboard's Signals page makes a random one.
SIGNAL_WEBHOOK=off
WEBHOOK_TOPIC=
# on: /buy and /sell from your Telegram chat open a trade.
SIGNAL_TELEGRAM=off

# on: the app starts the bot as soon as it opens (pair it with "Start with Windows" in the
# app) and restarts it if it stops on its own.
AUTO_START_BOT=off
