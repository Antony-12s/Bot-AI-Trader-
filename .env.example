# Copy this file to .env and fill it in. Keep comments on their own lines.

# dry  = never sends orders, only reports what it would do (start here)
# demo = sends orders, but only when the logged-in MT5 account is a demo account
# live = sends orders on any account, real money included
MODE=dry

# rules = strategy.py decides (free, same answer every time)
# ai    = Claude decides buy / sell / hold each closed candle (ai_strategy.py).
#         Costs money per candle: on M15 that is up to 96 API calls a day.
BRAIN=rules
# Only for BRAIN=ai. Create one at https://platform.claude.com (billed separately
# from a Claude subscription). Never commit this file.
ANTHROPIC_API_KEY=

# Symbol name exactly as your broker shows it (XAUUSD, XAUUSDm, GOLD, EURUSD, ...)
SYMBOL=XAUUSD
# M1 M5 M15 M30 H1 H4 D1
TIMEFRAME=M15
LOT=0.01

# Distances in points. Point size differs per broker: on gold quoted with
# 2 decimals 500 points = 5.00, with 3 decimals it is only 0.50. Check yours.
SL_POINTS=500
TP_POINTS=1000
MAX_SPREAD_POINTS=50

# Stop opening trades once today's realized loss reaches this (account currency)
MAX_DAILY_LOSS=20

# Tags this bot's orders so it only counts its own positions
MAGIC=20261003
# IOC, FOK or RETURN. Change it if orders fail with "Unsupported filling mode"
FILLING=IOC

# From @BotFather. Leave empty to run with console output only.
TELEGRAM_TOKEN=
# Your chat id. Message the bot once: the console prints "ignored message from chat <id>"
TELEGRAM_CHAT_ID=
